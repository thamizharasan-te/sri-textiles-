# --- தளம் ---
# தளத்தின் முகவரி (மின்னஞ்சல் இணைப்புகளுக்கு)
SITE_URL=http://localhost:3000
# தரவுத்தளம், படங்கள் சேமிக்கும் இடம் (இயல்புநிலை: ./data, ./uploads)
DATABASE_PATH=./data/shop.db
UPLOAD_DIR=./uploads

# --- நிர்வாகி (npm run create-admin இதைப் படிக்கும்) ---
ADMIN_USERNAME=owner
ADMIN_PASSWORD=

# --- Razorpay (சோதனைச் சாவிகள்: rzp_test_...) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- மின்னஞ்சல் (SMTP). காலியாக இருந்தால் மின்னஞ்சல் அனுப்பப்படாது, log-இல் மட்டும் தெரியும் ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sri Textiles <orders@example.com>"
