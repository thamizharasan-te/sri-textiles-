# --- தளம் ---
# தளத்தின் முகவரி (மின்னஞ்சல் இணைப்புகளுக்கு)
SITE_URL=http://localhost:3000
# --- தரவுத்தளம் ---
# Vercel/இணையத்தில்: Turso (இலவசம்). turso.tech-இல் உருவாக்கிய மதிப்புகள்:
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# உள்ளூரில் (மேலே காலியாக இருந்தால்) இந்தக் கோப்பு பயன்படும்:
DATABASE_PATH=./data/shop.db

# --- படங்கள் ---
# Vercel-இல்: Storage → Blob உருவாக்கினால் இது தானாகச் சேரும். காலியாக இருந்தால் UPLOAD_DIR கோப்புறை (உள்ளூர் மட்டும்)
BLOB_READ_WRITE_TOKEN=
UPLOAD_DIR=./uploads

# --- நிர்வாகி (npm run create-admin இதைப் படிக்கும்) ---
ADMIN_USERNAME=owner
ADMIN_PASSWORD=

# --- Razorpay (சோதனைச் சாவிகள்: rzp_test_...) ---
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# --- மின்னஞ்சல் (SMTP): ஆர்டர் உறுதி + கணக்கு சரிபார்ப்புக் குறியீடு ---
# Gmail பயன்படுத்த: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465, SMTP_USER=உங்கள்@gmail.com,
#   SMTP_PASS=Google "App Password" (Google கணக்கு → Security → 2-Step Verification → App passwords; சாதாரணக் கடவுச்சொல் அல்ல)
# காலியாக இருந்தால் (டெமோ / உள்ளூர் மேம்பாட்டில்) சரிபார்ப்புக் குறியீடு திரையிலேயே தெரியும்; உண்மைத் தளத்தில் sign up வேலை செய்யாது.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Sri Textiles <orders@example.com>"
